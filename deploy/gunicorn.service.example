# Example systemd unit. Copy to /etc/systemd/system/gunicorn.service,
# fix the paths/user, then: systemctl daemon-reload && systemctl enable --now gunicorn
[Unit]
Description=gunicorn daemon for AIM_Django
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/path/to/AIM_Django
EnvironmentFile=/path/to/AIM_Django/.env
RuntimeDirectory=gunicorn
ExecStart=/path/to/AIM_Django/venv/bin/gunicorn \
    --workers 3 \
    --bind unix:/run/gunicorn/aim_django.sock \
    AIM_Django.wsgi:application

[Install]
WantedBy=multi-user.target
