# Copy to .env on the server (never commit the real .env — it's gitignored).

# Generate one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

DJANGO_DEBUG=False

# Comma-separated, no spaces needed. Include your domain and/or server IP.
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
